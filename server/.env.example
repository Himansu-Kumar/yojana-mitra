# Copy to server/.env and fill in. Never commit .env.

PORT=5000

# MongoDB Atlas connection string.
# Leave EMPTY to use a temporary in-memory database (data is lost on restart; good for quick local dev).
MONGO_URI=

# Any long random string. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Python ML service (ml-service/). The app still works without it: chat falls back to a simple answer,
# document scanning returns an error.
ML_SERVICE_URL=http://localhost:8000

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
